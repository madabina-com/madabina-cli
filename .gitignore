# Ignore generated files except versioned binary payloads used by the tag-release workflow.
*
!.gitignore
!README.md
!README.fr.md
!README.ar.md
!LICENSE
!THIRD_PARTY_NOTICES.md
!third_party_licenses/
!third_party_licenses/**
!.github/
!.github/workflows/
!.github/workflows/publish-binary-release.yml
!.github/workflows/publish-apt-repository.yml
!apt/
!apt/**
!release-assets/
!release-assets/**
